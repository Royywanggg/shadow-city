{
  "name": "shadow-city",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=4 --testTimeout=120000",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "visual:check": "node scripts/visual-check.mjs",
    "visual:v02": "node scripts/v02-check.mjs",
    "visual:v03": "node scripts/v03-check.mjs",
    "visual:v04": "node scripts/v04-check.mjs",
    "visual:v05": "node scripts/v05-check.mjs",
    "visual:v051": "node scripts/v051-check.mjs",
    "visual:v0511": "node scripts/v0511-playback-check.mjs",
    "visual:v052": "node scripts/v052-check.mjs",
    "visual:v06": "node scripts/v06-check.mjs",
    "visual:architecture": "node scripts/architecture-check.mjs",
    "visual:lookdev": "node scripts/lookdev-check.mjs",
    "experiment:v06": "node scripts/v06-experiments.mjs",
    "assets:bake-impostors": "node scripts/bake-character-impostors.mjs",
    "assets:verify-characters": "python3 scripts/verify-character-animation-assets.py",
    "visual:characters": "node scripts/character-city-check.mjs",
    "visual:life": "node scripts/life-browser-check.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
